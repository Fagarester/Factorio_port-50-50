<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/BTRootGame"
            style="@style/ButtonAccent"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:textSize="14sp"
            android:text="@string/files_root_game" />

        <Button
            android:id="@+id/BTRootDownload"
            style="@style/ButtonAccent"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:textSize="14sp"
            android:text="@string/files_root_download" />
    </LinearLayout>

    <TextView
        android:id="@+id/TVPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:singleLine="true"
        android:ellipsize="start"
        android:textSize="13sp"
        android:textColor="?attr/colorSecondaryText" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/LVFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/list_item_divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/TVEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            android:textColor="?attr/colorSecondaryText" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:textSize="12sp"
        android:textColor="?attr/colorSecondaryText"
        android:text="@string/files_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/BTPaste"
            style="@style/ButtonAccent"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:textSize="14sp"
            android:visibility="gone"
            android:text="@string/files_paste" />

        <Button
            android:id="@+id/BTNewFolder"
            style="@style/ButtonAccent"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:textSize="14sp"
            android:text="@string/files_new_folder" />

        <Button
            android:id="@+id/BTAddFiles"
            style="@style/ButtonAccent"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:textSize="14sp"
            android:text="@string/files_add" />
    </LinearLayout>
</LinearLayout>
