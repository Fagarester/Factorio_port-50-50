<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <FrameLayout
                android:id="@+id/FLContainerSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/screen_size" />

                            <Spinner
                                style="@style/ComboBox"
                                android:layout_width="match_parent"
                                android:id="@+id/SScreenSize"
                                android:entries="@array/screen_size_entries" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/LLCustomScreenSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/width" />

                                <EditText
                                    style="@style/EditText"
                                    android:layout_width="78dp"
                                    android:id="@+id/ETScreenWidth"
                                    android:inputType="number" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textSize="18dp"
                                android:layout_gravity="bottom"
                                android:layout_marginLeft="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_marginBottom="4dp"
                                android:text="x" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/height" />

                                <EditText
                                    style="@style/EditText"
                                    android:layout_width="78dp"
                                    android:id="@+id/ETScreenHeight"
                                    android:inputType="number" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/graphics_driver" />

                    <LinearLayout
                        android:id="@+id/LLGraphicsDriver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_driver" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Spinner
                            style="@style/ComboBox"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:id="@+id/SAudioDriver"
                            android:entries="@array/audio_driver_entries" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTAudioDriverConfig"
                            android:src="@drawable/icon_audio_settings" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/LLTabEnvVars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.factorio.widget.EnvVarsView
                            android:id="@+id/EnvVarsView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"/>

                        <View style="@style/HorizontalLine" />

                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTAddEnvVar"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/add" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/container"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cursor_speed"/>
                    <com.factorio.widget.SeekBar
                        android:id="@+id/SBCursorSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:suffix="%"
                        app:minValue="10"
                        app:maxValue="200"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cursor_size"/>
                            <com.factorio.widget.SeekBar
                                android:id="@+id/SBCursorSize"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:suffix="%"
                                app:step="5"
                                app:minValue="100"
                                app:maxValue="200"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginLeft="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/color"/>
                            <com.factorio.widget.ColorPickerView
                                android:id="@+id/CPVCursorColor"
                                android:layout_width="84dp"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View style="@style/FieldSeparator"/>
                    <CheckBox
                        android:id="@+id/CBMoveCursorToTouchpoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/move_cursor_to_touchpoint"/>
                    <CheckBox
                        android:id="@+id/CBCapturePointerOnExternalMouse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/capture_pointer_on_external_mouse"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/mouse"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preferred_input_api"/>
                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SPreferredInputApi"
                        android:layout_width="match_parent"
                        android:entries="@array/preferred_input_api_entries"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/player"
                            android:layout_marginRight="8dp"/>
                        <LinearLayout style="@style/Toolbox">
                            <LinearLayout
                                android:id="@+id/LLGamepadPlayer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <ImageView
                                    style="@style/ListMenuButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/gamepad_player_1"/>
                                <ImageView
                                    style="@style/ListMenuButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/gamepad_player_2"/>
                                <ImageView
                                    style="@style/ListMenuButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/gamepad_player_3"/>
                                <ImageView
                                    style="@style/ListMenuButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/gamepad_player_4"/>
                            </LinearLayout>
                            <View style="@style/VerticalLine"/>
                            <ImageView
                                android:id="@+id/BTResetGamepadPlayerConfigs"
                                style="@style/ListMenuButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icon_reset"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/game_controllers"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/language"/>
                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SLanguage"
                        android:layout_width="match_parent"
                        android:entries="@array/language_entries"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme"/>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">
                        <RadioGroup
                            android:id="@+id/RGAppTheme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <RadioButton
                                android:id="@+id/RBLight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/light"/>
                            <RadioButton
                                android:id="@+id/RBDark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dark"/>
                            <RadioButton
                                android:id="@+id/RBDark1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dark1"/>
                            <RadioButton
                                android:id="@+id/RBDark2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dark2"/>
                            <RadioButton
                                android:id="@+id/RBDark3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dark3"/>
                            <RadioButton
                                android:id="@+id/RBDark4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dark4"/>
                            <RadioButton
                                android:id="@+id/RBDark5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dark5"/>
                            <RadioButton
                                android:id="@+id/RBDark6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dark6"/>
                            <RadioButton
                                android:id="@+id/RBDark7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dark7"/>
                            <RadioButton
                                android:id="@+id/RBDark8"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dark8"/>
                        </RadioGroup>
                    </HorizontalScrollView>
                </LinearLayout>
                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/system"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <CheckBox
                        android:id="@+id/CBEnableDebugLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_debug_logs"/>
                    <View style="@style/FieldSeparator"/>
                    <CheckBox
                        android:id="@+id/CBSaveLogsToFile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/save_logs_to_file"
                        android:layout_marginTop="8dp"/>
                    <EditText
                        android:id="@+id/ETLogFile"
                        style="@style/EditText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"/>
                    <View style="@style/FieldSeparator"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal">
                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTReinstallSystemFiles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/reinstall_system_files"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/advanced"/>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/BTConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|bottom"
        android:tint="#ffffff"
        android:src="@drawable/icon_confirm"
        android:layout_margin="16dp"/>
</FrameLayout>