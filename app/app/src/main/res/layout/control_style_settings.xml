<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <TextView
            android:id="@+id/TVStyleTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/style_hint" />

        <CheckBox
            android:id="@+id/CBStyleOutline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/style_show_outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_outline_color" />

            <com.factorio.widget.ColorPickerView
                android:id="@+id/CPVStyleOutline"
                android:layout_width="84dp"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/style_outline_alpha" />

        <com.factorio.widget.SeekBar
            android:id="@+id/SBStyleOutlineAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:suffix="%"
            app:step="5"
            app:minValue="0"
            app:maxValue="100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_content_color" />

            <com.factorio.widget.ColorPickerView
                android:id="@+id/CPVStyleContent"
                android:layout_width="84dp"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/style_content_alpha" />

        <com.factorio.widget.SeekBar
            android:id="@+id/SBStyleContentAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:suffix="%"
            app:step="5"
            app:minValue="0"
            app:maxValue="100" />

        <CheckBox
            android:id="@+id/CBStyleIconFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/style_icon_filter" />

        <Button
            style="@style/ButtonNeutral"
            android:id="@+id/BTStyleReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/style_reset_all" />
    </LinearLayout>
</ScrollView>
