<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clickable="false"
    android:focusable="false">

    <!-- Full-screen splash, stretched to any screen / container resolution -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/splash_screen_background"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Factorio assembling machine as the progress animation -->
    <com.factorio.widget.AssemblerLoaderView
        android:layout_width="150dp"
        android:layout_height="163dp"
        android:layout_gravity="center" />

    <!-- Kept (hidden) because DownloadProgressDialog.java still updates it -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/CircularProgressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:trackThickness="10dp"
        app:indicatorSize="64dp" />

    <!-- Caption + percent at the top of the screen -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/TextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#CCFFFFFF"
            android:text="@string/downloading_file" />

        <TextView
            android:id="@+id/TVProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:textSize="14sp"
            android:textColor="#FFFF8F00" />
    </LinearLayout>

    <!-- First start only: choose the container resolution (720p / 1080p / native), at the bottom -->
    <LinearLayout
        android:id="@+id/LLResolutionPicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/TVResolutionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="#FFFFFFFF"
            android:text="@string/choose_resolution" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/BTRes720"
                style="@style/ButtonAccent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="104dp"
                android:minHeight="52dp"
                android:lines="2"
                android:textSize="14sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/BTRes1080"
                style="@style/ButtonAccent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="104dp"
                android:minHeight="52dp"
                android:lines="2"
                android:textSize="14sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/BTResNative"
                style="@style/ButtonAccent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="104dp"
                android:minHeight="52dp"
                android:lines="2"
                android:textSize="14sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cancel button (shown only for cancelable downloads) -->
    <LinearLayout
        android:id="@+id/LLBottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:visibility="gone">

        <Button
            style="@style/ButtonNeutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:id="@+id/BTCancel" />
    </LinearLayout>
</FrameLayout>
