<?xml version="1.0" encoding="utf-8"?>
<!-- A choice on the "where is the game" screen: dark glass card, orange edge while pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#E02A2118" />
            <stroke android:width="1.5dp" android:color="#FFF29A1F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#C8181818" />
            <stroke android:width="1dp" android:color="#FF3A3A3A" />
        </shape>
    </item>
</selector>
