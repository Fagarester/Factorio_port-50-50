<?xml version="1.0" encoding="utf-8"?>
<!-- The demo's card: the one orange choice, darker while pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="270" android:startColor="#FFE07A10" android:endColor="#FFB34700" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="270" android:startColor="#FFFF9A2A" android:endColor="#FFE65100" />
        </shape>
    </item>
</selector>
